{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "esModuleInterop": true
  },
  "include": ["src", "test", "../src/domain/*.ts"],
  "exclude": ["../src/domain/__tests__"]
}
