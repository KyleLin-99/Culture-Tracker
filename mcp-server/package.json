{
  "name": "culture-tracker-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for a Culture Tracker lab",
  "type": "module",
  "bin": {
    "culture-tracker-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/tools.test.ts test/session.test.ts",
    "login": "node dist/index.js login",
    "start": "node dist/index.js",
    "test:integration": "npm run build && tsx --test test/server.int.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "^2.119.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
