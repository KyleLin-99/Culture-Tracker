# Copy to .env and fill in from Supabase: Project Settings > API Keys.
# Both values are safe to ship in the app; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: where the web app is hosted (e.g. https://culture-tracker.example.com),
# so shared lineage links are normal web links. Leave empty until it's hosted.
EXPO_PUBLIC_WEB_URL=
