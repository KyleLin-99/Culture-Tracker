{
  "name": "culture-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@playwright/test": "1.65.1",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.16.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "pg": "^8.23.1",
    "sql.js": "^1.17.0",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:db": "supabase test db",
    "test:e2e": "node e2e/build-web.mjs && playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "test:integration": "jest -c jest.integration.config.js",
    "test:e2e:real": "node e2e-real/build.mjs && playwright test -c playwright.real.config.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/integration/"
    ]
  }
}
